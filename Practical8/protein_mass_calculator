def calculate_protein_mass(sequence):
    # Monoisotopic residue mass table
    mass_table = {
        'G': 57.02,
        'A': 71.04,
        'S': 87.03,
        'P': 97.05,
        'V': 99.07,
        'T': 101.05,
        'C': 103.01,
        'I': 113.08,
        'L': 113.08,
        'N': 114.04,
        'D': 115.03,
        'Q': 128.06,
        'K': 128.09,
        'E': 129.04,
        'M': 131.04,
        'H': 137.06,
        'F': 147.07,
        'R': 156.10,
        'Y': 163.06,
        'W': 186.08
    }

    total_mass = 0.0

    for aa in sequence:
        if aa not in mass_table:
            raise ValueError(f"Invalid amino acid symbol: {aa}")
        total_mass += mass_table[aa]

    return total_mass

# Example function call
if __name__ == "__main__":
    test_sequence = "GAVL"
    mass = calculate_protein_mass(test_sequence)
    print(f"Sequence: {test_sequence}")
    print(f"Total protein mass: {mass} amu")
    invalid_test_sequence = "GAVLX"
    try:
        invalid_mass = calculate_protein_mass(invalid_test_sequence)
        print(f"Sequence: {invalid_test_sequence}")
        print(f"Total protein mass: {invalid_mass} amu")
    except ValueError as e:
        print(f"Error: {e}")